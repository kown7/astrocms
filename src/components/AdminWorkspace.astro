---
import '../assets/admin.css';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<div class="admin-shell">
	<aside class="sidebar" aria-label="Admin navigation">
		<a class="brand" href={baseUrl} aria-label="Astro CMS home"><span class="brand-symbol">A</span><span class="brand-copy"><strong>Astro CMS</strong><small>LOCAL CONTENT STUDIO</small></span></a>
		<div class="site-picker"><span class="site-avatar">AS</span><span class="site-copy"><small>WORKSPACE</small><strong>Astro site</strong></span><span class="site-chevron">⌄</span></div>
		<div class="nav-label">CONTENT</div>
		<nav class="side-nav" aria-label="Content sections">
			<button class="nav-item is-active" type="button" data-view="overview" aria-current="page"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="5" height="5" rx="1"/><rect x="12" y="3" width="5" height="5" rx="1"/><rect x="3" y="12" width="5" height="5" rx="1"/><rect x="12" y="12" width="5" height="5" rx="1"/></svg><span>Overview</span></button>
			<button class="nav-item" type="button" data-view="menus"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5h12M4 10h12M4 15h12"/><circle cx="2.5" cy="5" r=".6"/><circle cx="2.5" cy="10" r=".6"/><circle cx="2.5" cy="15" r=".6"/></svg><span>Menus</span><span class="nav-count" data-category-nav-count="menus">0</span></button>
			<button class="nav-item" type="button" data-view="blog"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.8h6l4 4v10.4H5z"/><path d="M11 3v4h4M7.5 11h5M7.5 14h5"/></svg><span>Blog posts</span><span class="nav-count" data-category-nav-count="blog">0</span></button>
			<button class="nav-item" type="button" data-view="content"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3.5h12v13H4zM7 7h6M7 10h6M7 13h4"/></svg><span>Content</span><span class="nav-count" data-category-nav-count="content">0</span></button>
		</nav>
		<div class="nav-label nav-label-git">REPOSITORY</div>
		<nav class="side-nav" aria-label="Repository files"><button class="nav-item" type="button" data-view="files"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 4.5h5l1.5 2h6.5v9h-13z"/><path d="M3.5 7h13"/></svg><span>Files</span></button><button class="nav-item" type="button" data-view="commits"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="5" cy="4" r="2"/><circle cx="15" cy="16" r="2"/><circle cx="15" cy="4" r="2"/><path d="M5 6v3a3 3 0 0 0 3 3h4a3 3 0 0 1 3 3"/></svg><span>Commit history</span><span class="nav-count nav-count-blue" data-commit-count>0</span></button></nav>
		<div class="sidebar-bottom"><div class="snapshot-card"><div class="snapshot-title"><span></span>BUILD SNAPSHOT</div><strong data-sidebar-branch>Loading…</strong><div class="snapshot-sha">BASE <code data-sidebar-sha>—</code></div><div class="snapshot-note" data-sidebar-state>Opening local repository</div></div><div class="profile-row"><span class="profile-avatar">ME</span><span><strong>Local editor</strong><small>Browser workspace</small></span></div></div>
	</aside>

	<main class="main-panel">
		<header class="topbar"><div class="crumbs"><span>Astro site</span><span class="crumb-divider">/</span><strong data-breadcrumb>Overview</strong></div><div class="topbar-actions"><span class="local-badge"><i></i>Local repository</span><button class="button button-primary" type="button" data-action="download"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3-3m-3 3L7 9M4 14v3h12v-3"/></svg>Export repository</button></div></header>
		<div class="local-git-banner" role="status"><span class="status-pill">LOCAL GIT</span><span>Edits and commits are stored in this browser. Remote Git is never contacted.</span><button type="button" data-action="flow-help">How publishing works <span>→</span></button></div>
		<div class="stale-base-banner" data-stale-warning role="alert" hidden></div>
		<div class="page-body">
			<section class="view-screen" data-screen="overview">
				<div class="page-heading"><div><p class="eyebrow">LOCAL CONTENT WORKSPACE</p><h1>Your site, ready to edit.</h1><p class="subheading">A browser editor for the Git repository snapshot from your last build.</p></div><button class="button button-primary" type="button" data-view="menus">Open editor <span>→</span></button></div>
				<div class="snapshot-card-main card"><div class="snapshot-main"><span class="snapshot-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5h9l5 5v12H5z"/><path d="M14 4v5h5M8 13h8M8 16h6"/></svg></span><div><p class="eyebrow">EMBEDDED REPOSITORY</p><h2>Astro site</h2><p>Current local Git repository packaged at build time.</p></div></div><div class="snapshot-metadata"><div><span>BRANCH</span><strong><i class="branch-glyph">⑂</i> <span data-overview-branch>Loading…</span></strong></div><div><span>BASE COMMIT</span><strong><code data-overview-base>—</code></strong></div><div><span>BUILT</span><strong data-overview-built>—</strong></div><div><span>REMOTE</span><strong class="muted-value">Not contacted</strong></div></div><div class="snapshot-footer"><span><i class="success-dot"></i> <span data-repository-state>Opening browser repository…</span></span><button class="text-link" type="button" data-view="commits">View commit history <span>→</span></button></div></div>
				<div class="workflow-heading"><div><p class="eyebrow">THE WORKFLOW</p><h2>Edit here. Push from your console.</h2></div><span>No remote credentials in the browser</span></div>
				<div class="workflow-grid"><article class="workflow-card"><span class="step-number">01</span><span class="workflow-icon violet"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3.5h12v13H4zM7 7h6M7 10h6M7 13h4"/></svg></span><h3>Edit content</h3><p>Change menu YAML, blog posts, Markdown pages, and any other repository file.</p><button class="text-link" type="button" data-view="menus">Start editing <span>→</span></button></article><article class="workflow-card"><span class="step-number">02</span><span class="workflow-icon green"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="5" cy="4" r="2"/><circle cx="15" cy="16" r="2"/><circle cx="15" cy="4" r="2"/><path d="M5 6v3a3 3 0 0 0 3 3h4a3 3 0 0 1 3 3"/></svg></span><h3>Commit locally</h3><p>Create real commits in the browser repository. They persist across reloads.</p><button class="text-link" type="button" data-view="commits">Review commits <span>→</span></button></article><article class="workflow-card"><span class="step-number">03</span><span class="workflow-icon amber"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3-3m-3 3L7 9M4 14v3h12v-3"/></svg></span><h3>Download &amp; push</h3><p>Export the complete repository and use native Git in your console.</p><button class="text-link" type="button" data-action="download">See export details <span>→</span></button></article></div>
				<div class="overview-bottom-grid"><article class="card recent-card"><div class="section-heading"><div><p class="eyebrow">REPOSITORY</p><h2>Files</h2></div><button class="text-link" type="button" data-view="files">Browse files <span>→</span></button></div><div data-recent-files><p class="subheading">Loading repository files…</p></div></article><article class="card next-step-card"><p class="eyebrow">AFTER EXPORT</p><h2>Push with your usual Git tools</h2><p>The downloaded ZIP contains the local `.git` repository and current working files.</p><div class="command-preview"><span>$</span> git push origin <span data-push-branch>main</span></div><button class="text-link" type="button" data-action="flow-help">View console steps <span>→</span></button></article></div>
			</section>

			<section class="view-screen" data-screen="editor" hidden><div class="page-heading editor-heading"><div><p class="eyebrow">REPOSITORY EDITOR</p><h1 data-editor-heading>Files</h1><p class="subheading" data-editor-description>Browse and edit files in the local Git working tree.</p></div><div class="heading-actions"><button class="button button-secondary" type="button" data-action="new-file"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v14M3 10h14"/></svg>New text file</button><button class="button button-primary" type="button" data-action="download"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3-3m-3 3L7 9M4 14v3h12v-3"/></svg>Export repo</button></div></div>
				<div class="category-tabs" role="tablist" aria-label="Content type"><button class="category-tab is-active" type="button" role="tab" aria-selected="true" data-category="menus">Menus <span data-category-count="menus">0</span></button><button class="category-tab" type="button" role="tab" aria-selected="false" data-category="blog">Blog posts <span data-category-count="blog">0</span></button><button class="category-tab" type="button" role="tab" aria-selected="false" data-category="content">Content <span data-category-count="content">0</span></button></div>
				<div class="editor-workspace card"><aside class="file-browser"><div class="file-browser-heading"><strong data-list-heading>Files</strong><button class="icon-button" type="button" aria-label="Add a text file" data-action="new-file">＋</button></div><label class="search-box"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg><input type="search" placeholder="Filter files" aria-label="Filter files" data-file-search /></label><div class="file-list" role="listbox" aria-label="Repository files" data-file-list></div><div class="file-browser-footer"><span class="tiny-status-dot"></span><span data-list-state>Local worktree</span><span>·</span><span data-visible-count>0 files</span></div></aside><div class="editor-panel"><div class="editor-toolbar"><div class="editor-file-title"><span class="file-mark markdown-mark" data-editor-mark>F</span><span><strong data-editor-filename>Select a file</strong><small data-editor-path></small></span><i class="dirty-indicator" data-dirty-indicator hidden></i></div><div class="editor-toolbar-actions"><span class="editor-language" data-language>—</span><button class="button button-secondary button-small" type="button" data-action="rename" disabled>Rename</button><button class="button button-secondary button-small" type="button" data-action="delete" disabled>Delete</button></div></div><div class="editor-content" data-text-panel><div class="line-gutter" aria-hidden="true" data-line-gutter></div><textarea class="text-editor" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Edit selected source file" data-text-editor disabled></textarea></div><div class="binary-panel" data-binary-panel hidden><img alt="Selected image asset preview" data-image-preview hidden /><p data-binary-message>Select a file to preview or download it.</p><div class="binary-actions"><button class="button button-secondary button-small" type="button" data-action="upload">Replace / upload asset</button><button class="button button-secondary button-small" type="button" data-action="download-file" disabled>Download file</button><input type="file" data-upload-input hidden /></div></div><div class="editor-toolbar-actions editor-save-actions"><span class="editor-language" data-language>UTF-8 · Plain text</span><button class="button button-secondary button-small" type="button" data-action="save" disabled>Save to worktree</button><button class="button button-secondary button-small" type="button" data-action="upload">Upload asset</button></div><div class="editor-status"><span><i></i> <span data-editor-status>Local working tree</span></span><span>UTF-8 <b>·</b> Plain text</span></div><div class="commit-inline"><div><span class="commit-avatar">G</span><span><strong>Ready to commit?</strong><small>Save worktree changes, then create a local Git commit.</small></span></div><button class="button button-primary" type="button" data-action="commit">Commit locally</button></div></div></div>
				<div class="editor-footnote"><span class="info-icon">i</span><span>Changes are stored in this browser's local Git worktree. Commit to record them in history, or export the repository.</span></div>
			</section>

			<section class="view-screen" data-screen="commits" hidden><div class="page-heading"><div><p class="eyebrow">LOCAL GIT HISTORY</p><h1>Commits</h1><p class="subheading">Actual commits from this repository’s current branch.</p></div><button class="button button-primary" type="button" data-action="download"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3-3m-3 3L7 9M4 14v3h12v-3"/></svg>Export repository</button></div><div class="git-state-bar"><span class="git-branch"><i>⑂</i> <span data-history-branch>—</span></span><span class="git-state-divider"></span><span>Base <code data-history-base>—</code></span><span class="git-state-divider"></span><span class="local-only"><i></i>No remote connection</span></div><div class="card history-card"><div class="history-header"><div><p class="eyebrow">COMMIT HISTORY</p><h2 data-history-count>Loading history…</h2></div><span class="worktree-label" data-worktree-status>WORKTREE</span></div><div class="history-list" data-history-list></div></div><div class="console-note card"><span class="console-icon">$</span><div><strong>Push from your console when you’re ready</strong><p>The exported archive includes your `.git` directory and working files.</p><code data-push-command>git push origin main</code></div></div></section>
		</div>
		<footer class="admin-footer"><span>Astro CMS · local-first editing</span><span>Browser-local Git <i>•</i> No remote Git calls</span></footer>
	</main>
</div>

<dialog class="modal" data-dialog="download"><div class="modal-card"><button class="modal-close" type="button" aria-label="Close dialog" data-close>×</button><span class="modal-icon download-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg></span><p class="eyebrow">EXPORT WORKING REPOSITORY</p><h2>Take your Git repository with you.</h2><p class="modal-copy">Export a ZIP of the current worktree and `.git` history, including browser-created commits. Push it from your console with your existing Git credentials.</p><div class="export-facts"><div><span>BRANCH</span><strong data-export-branch>—</strong></div><div><span>BASE HEAD</span><strong><code data-export-base>—</code></strong></div><div><span>REMOTE</span><strong>Not contacted</strong></div></div><div class="export-warning"><span>!</span><p>The archive is created locally in your browser. No Git remote is contacted.</p></div><button class="button button-primary modal-button" type="button" data-action="export">Download repository ZIP</button></div></dialog>

<dialog class="modal" data-dialog="commit"><form class="modal-card" data-commit-form><button class="modal-close" type="button" aria-label="Close dialog" data-close>×</button><span class="modal-icon commit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M6 7v4a4 4 0 0 0 4 4h4a4 4 0 0 1 4 4"/></svg></span><p class="eyebrow">LOCAL COMMIT</p><h2>Create a commit</h2><p class="modal-copy">Save selected repository changes in the current local branch. No remote is contacted.</p><label for="commit-message">Commit message</label><input id="commit-message" name="message" required placeholder="Describe your changes" /><label for="commit-author-name">Author name</label><input id="commit-author-name" name="authorName" required placeholder="Your name" /><label for="commit-author-email">Author email</label><input id="commit-author-email" name="authorEmail" type="email" required placeholder="you@example.com" /><button class="button button-primary modal-button" type="submit">Create local commit</button></form></dialog>

<dialog class="modal" data-dialog="new-file"><form class="modal-card" data-new-file-form><button class="modal-close" type="button" aria-label="Close dialog" data-close>×</button><span class="modal-icon new-file-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg></span><p class="eyebrow">NEW TEXT FILE</p><h2>Create a repository file</h2><p class="modal-copy">Choose a path relative to the repository root. Parent folders are created as needed.</p><label for="new-file-path">Repository path</label><input id="new-file-path" name="path" required placeholder="src/content/blog/new-post.md" /><label for="new-file-content">Initial text</label><textarea id="new-file-content" name="content" rows="7" placeholder="Start writing…"></textarea><button class="button button-primary modal-button" type="submit">Create file</button></form></dialog>

<div class="toast" role="status" aria-live="polite" data-toast hidden></div>

<script>
	import './admin-workspace.js';
</script>

<style>
	.binary-panel { min-height: 330px; flex: 1; padding: 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; overflow: auto; background: #fdfdfe; }
	.binary-panel > img { max-width: 100%; max-height: 360px; object-fit: contain; border: 1px solid #eceef2; background: white; }
	.stale-base-banner { padding: 8px 34px; border-bottom: 1px solid #f0e2c6; color: #876f4c; background: #fffaf0; font-size: 9px; }
	.binary-panel > p { color: #858b98; font-size: 9px; }
	.binary-actions, .editor-save-actions { display: flex; align-items: center; gap: 8px; }
	.editor-save-actions { justify-content: flex-end; padding: 6px 12px; border-top: 1px solid #eceef2; }
	.editor-save-actions .editor-language { margin-right: auto; }
	[data-new-file-form] textarea { width: 100%; min-height: 130px; padding: 9px; border: 1px solid #e2e5eb; border-radius: 6px; color: #4b515d; resize: vertical; font: 9px/1.5 ui-monospace, monospace; }
	[data-recent-files] .recent-file { border-top: 1px solid #eff0f3; }
	@media (max-width: 620px) { .editor-save-actions { flex-wrap: wrap; } }
</style>
